<!DOCTYPE RCC>
<RCC version="1.0">
  <qresource prefix="/icons">
    <file alias="chevron-left.svg">icons/chevron-left.svg</file>
    <file alias="chevron-right.svg">icons/chevron-right.svg</file>
    <file alias="refresh-cw.svg">icons/refresh-cw.svg</file>
    <file alias="square.svg">icons/square.svg</file>
    <file alias="search.svg">icons/search.svg</file>
    <file alias="share.svg">icons/share.svg</file>
    <file alias="plus.svg">icons/plus.svg</file>
    <file alias="address-field-frame.svg">icons/address-field-frame.svg</file>
  </qresource>
  <qresource prefix="/fonts">
    <file alias="GoogleSansFlex-Regular.ttf">fonts/GoogleSansFlex-Regular.ttf</file>
    <file alias="GoogleSansFlex-Medium.ttf">fonts/GoogleSansFlex-Medium.ttf</file>
    <file alias="NotoSansSC-Regular.ttf">fonts/NotoSansSC-Regular.ttf</file>
    <file alias="NotoSansSC-Medium.ttf">fonts/NotoSansSC-Medium.ttf</file>
    <file alias="OFL-GoogleSansFlex.txt">fonts/OFL-GoogleSansFlex.txt</file>
    <file alias="OFL-NotoSansSC.txt">fonts/OFL-NotoSansSC.txt</file>
    <file alias="FONT_SOURCES.md">fonts/FONT_SOURCES.md</file>
  </qresource>
</RCC>
