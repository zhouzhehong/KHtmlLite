Grammar

    0 $accept: stylesheet $end

    1 stylesheet: maybe_space maybe_charset maybe_sgml import_list namespace_list rule_list
    2           | khtml_rule maybe_space
    3           | khtml_decls maybe_space
    4           | khtml_value maybe_space
    5           | khtml_mediaquery maybe_space
    6           | khtml_selectors maybe_space

    7 ruleset_or_import_or_namespace: ruleset
    8                               | import
    9                               | namespace_rule

   10 khtml_rule: KHTML_RULE_SYM '{' maybe_space ruleset_or_import_or_namespace maybe_space '}'

   11 khtml_decls: KHTML_DECLS_SYM declaration_block

   12 khtml_value: KHTML_VALUE_SYM '{' maybe_space expr '}'

   13 khtml_selectors: KHTML_SELECTORS_SYM '{' maybe_space selector_list '}'

   14 khtml_mediaquery: KHTML_MEDIAQUERY_SYM S maybe_space media_query '}'

   15 maybe_plus: %empty
   16           | '+'

   17 maybe_space: %empty
   18            | maybe_space S

   19 maybe_sgml: %empty
   20           | maybe_sgml SGML_CD
   21           | maybe_sgml S

   22 maybe_charset: %empty
   23              | charset

   24 charset: CHARSET_SYM maybe_space STRING maybe_space ';'
   25        | CHARSET_SYM error invalid_block
   26        | CHARSET_SYM error ';'

   27 import_list: %empty
   28            | import_list import maybe_sgml

   29 import: IMPORT_SYM maybe_space string_or_uri maybe_space maybe_media_list ';'
   30       | IMPORT_SYM error invalid_block
   31       | IMPORT_SYM error ';'

   32 namespace_list: %empty
   33               | namespace_list namespace maybe_sgml

   34 namespace_rule: NAMESPACE_SYM maybe_space maybe_ns_prefix string_or_uri

   35 namespace: namespace_rule maybe_space ';'
   36          | NAMESPACE_SYM error invalid_block
   37          | NAMESPACE_SYM error ';'

   38 maybe_ns_prefix: %empty
   39                | IDENT S

   40 rule_list: %empty
   41          | rule_list rule maybe_sgml

   42 rule: ruleset
   43     | media
   44     | page
   45     | font_face
   46     | invalid_rule
   47     | invalid_at
   48     | import error

   49 safe_ruleset: ruleset
   50             | invalid_rule
   51             | invalid_at
   52             | import error

   53 string_or_uri: STRING
   54              | URI

   55 media_feature: IDENT maybe_space

   56 maybe_media_value: %empty
   57                  | ':' maybe_space expr maybe_space

   58 media_query_exp: '(' maybe_space media_feature maybe_space maybe_media_value ')' maybe_space

   59 media_query_exp_list: media_query_exp
   60                     | media_query_exp_list maybe_space MEDIA_AND maybe_space media_query_exp

   61 maybe_and_media_query_exp_list: %empty
   62                               | MEDIA_AND maybe_space media_query_exp_list

   63 maybe_media_restrictor: %empty
   64                       | MEDIA_ONLY
   65                       | MEDIA_NOT

   66 media_query: media_query_exp_list
   67            | maybe_media_restrictor maybe_space medium maybe_and_media_query_exp_list

   68 maybe_media_list: %empty
   69                 | media_list

   70 media_list: media_query
   71           | media_list ',' maybe_space media_query
   72           | media_list error

   73 media: MEDIA_SYM maybe_space media_list '{' maybe_space ruleset_list '}'
   74      | MEDIA_SYM maybe_space '{' maybe_space ruleset_list '}'

   75 ruleset_list: %empty
   76             | ruleset_list safe_ruleset maybe_space

   77 medium: IDENT maybe_space

   78 page: PAGE_SYM error invalid_block
   79     | PAGE_SYM error ';'

   80 font_face: FONT_FACE_SYM maybe_space declaration_block
   81          | FONT_FACE_SYM error invalid_block
   82          | FONT_FACE_SYM error ';'

   83 combinator: '+' maybe_space
   84           | '~' maybe_space
   85           | '>' maybe_space

   86 unary_operator: '-'
   87               | '+'

   88 ruleset: selector_list declaration_block

   89 selector_list: selector
   90              | selector_list ',' maybe_space selector
   91              | selector_list error

   92 selector: simple_selector
   93         | selector S
   94         | selector S simple_selector
   95         | selector combinator simple_selector
   96         | selector error

   97 namespace_selector: '|'
   98                   | '*' '|'
   99                   | IDENT '|'

  100 simple_selector: element_name
  101                | element_name specifier_list
  102                | specifier_list
  103                | namespace_selector element_name
  104                | namespace_selector element_name specifier_list
  105                | namespace_selector specifier_list

  106 simple_css3_selector: element_name
  107                     | specifier
  108                     | namespace_selector element_name
  109                     | namespace_selector specifier

  110 element_name: IDENT
  111             | '*'

  112 specifier_list: specifier
  113               | specifier_list specifier
  114               | specifier_list error

  115 specifier: HASH
  116          | class
  117          | attrib
  118          | pseudo

  119 class: '.' IDENT

  120 attrib_id: IDENT maybe_space

  121 attrib: '[' maybe_space attrib_id ']'
  122       | '[' maybe_space attrib_id match maybe_space ident_or_string maybe_space ']'
  123       | '[' maybe_space namespace_selector attrib_id ']'
  124       | '[' maybe_space namespace_selector attrib_id match maybe_space ident_or_string maybe_space ']'

  125 match: '='
  126      | INCLUDES
  127      | DASHMATCH
  128      | BEGINSWITH
  129      | ENDSWITH
  130      | CONTAINS

  131 ident_or_string: IDENT
  132                | STRING

  133 pseudo: ':' IDENT
  134       | ':' ':' IDENT
  135       | ':' FUNCTION maybe_space NTH maybe_space ')'
  136       | ':' FUNCTION maybe_space maybe_plus INTEGER maybe_space ')'
  137       | ':' FUNCTION maybe_space IDENT maybe_space ')'
  138       | ':' FUNCTION maybe_space STRING maybe_space ')'
  139       | ':' NOTFUNCTION maybe_space simple_css3_selector maybe_space ')'

  140 declaration_block: '{' maybe_space declaration '}'
  141                  | '{' maybe_space error '}'
  142                  | '{' maybe_space declaration_list '}'
  143                  | '{' maybe_space declaration_list declaration '}'
  144                  | '{' maybe_space declaration_list error '}'

  145 declaration_list: declaration ';' maybe_space
  146                 | error ';' maybe_space
  147                 | declaration_list declaration ';' maybe_space
  148                 | declaration_list error ';' maybe_space

  149 declaration: property ':' maybe_space expr prio
  150            | error invalid_block

  151 property: IDENT maybe_space

  152 prio: IMPORTANT_SYM maybe_space
  153     | %empty

  154 expr: term
  155     | expr operator term

  156 operator: '/' maybe_space
  157         | ',' maybe_space
  158         | %empty

  159 term: unary_term
  160     | unary_operator unary_term
  161     | DIMEN maybe_space
  162     | STRING maybe_space
  163     | IDENT maybe_space
  164     | URI maybe_space
  165     | UNICODERANGE maybe_space
  166     | hexcolor
  167     | function

  168 unary_term: INTEGER maybe_space
  169           | FLOAT maybe_space
  170           | PERCENTAGE maybe_space
  171           | PXS maybe_space
  172           | CMS maybe_space
  173           | MMS maybe_space
  174           | INS maybe_space
  175           | PTS maybe_space
  176           | PCS maybe_space
  177           | DEGS maybe_space
  178           | RADS maybe_space
  179           | GRADS maybe_space
  180           | MSECS maybe_space
  181           | SECS maybe_space
  182           | HERZ maybe_space
  183           | KHERZ maybe_space
  184           | EMS maybe_space
  185           | QEMS maybe_space
  186           | EXS maybe_space
  187           | CHS maybe_space
  188           | REMS maybe_space
  189           | DPI maybe_space
  190           | DPCM maybe_space
  191           | VH maybe_space
  192           | VW maybe_space
  193           | VMIN maybe_space
  194           | VMAX maybe_space

  195 function: FUNCTION maybe_space expr ')' maybe_space
  196         | FUNCTION maybe_space error

  197 hexcolor: HEXCOLOR maybe_space

  198 invalid_at: '@' error invalid_block
  199           | '@' error ';'

  200 invalid_rule: error invalid_block

  201 invalid_block: '{' error invalid_block_list error '}'
  202              | '{' error '}'

  203 invalid_block_list: invalid_block
  204                   | invalid_block_list error invalid_block


